# Session signing secret — generate a long random string
# openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-secret

# SQLite file path. Docker/NAS: /data/app.db on the persistent volume.
# Do not set this to /app/data/app.db (that path is inside the image and is replaced on every deploy).
DATABASE_PATH=./data/app.db

# FORCE_RESEED=1 upserts the program catalog, then prunes unused catalog rows that have no set_logs.
# Explicit and logged. Never deletes set_logs / users / 1RMs / WOD history.
# Leave unset for routine deploys (SEED_REVISION bumps also preserve logs).

# Public site URL for password-reset links (no trailing slash). APP_URL wins over BASE_URL.
APP_URL=http://soopark.myds.me:7001
# BASE_URL=http://soopark.myds.me:7001

# Optional SMTP. If unset, forgot-password shows a one-time reset link on screen (home LAN).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=0

# Affiliate gear JSON. Default: file next to SQLite (/data/gear-affiliates.json), else image data/gear-affiliates.json.
# Fill affiliateUrl with real partner links. Empty or example.com shows 「링크 미설정」.
# GEAR_JSON_PATH=/data/gear-affiliates.json

# Node environment
NODE_ENV=production
PORT=3000
