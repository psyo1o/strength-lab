# Session signing secret — generate a long random string
# openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-secret

# SQLite file path. In Docker this is /data/app.db (volume-mounted).
DATABASE_PATH=./data/app.db

# Optional. Do not require a LAN IP in app code.
# APP_URL=http://localhost:3000

# Node environment
NODE_ENV=production
PORT=3000
