# Session signing secret — generate a long random string
# openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-secret

# SQLite file path. Docker/NAS: /data/app.db on the persistent volume.
# Do not set this to /app/data/app.db (that path is inside the image and is replaced on every deploy).
DATABASE_PATH=./data/app.db

# FORCE_RESEED=1 upserts the program catalog, then prunes unused catalog rows that have no set_logs.
# Explicit and logged. Never deletes set_logs / users / 1RMs / WOD history.
# Leave unset for routine deploys (SEED_REVISION bumps also preserve logs).

# Public site URL for password-reset links (no trailing slash). APP_URL wins over BASE_URL.
APP_URL=http://soopark.myds.me:7001
# BASE_URL=http://soopark.myds.me:7001

# Optional SMTP. If unset, forgot-password shows a one-time reset link on screen (home LAN).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=0

# Affiliate gear JSON. Reference cards ship in data/gear-affiliates.json.
# coupangPartnerId is an account id, not a link. Do not build a URL from it, and do not use search URLs.
# GEAR_JSON_PATH=/data/gear-affiliates.json

# Server-only OpenAI API key. This value is the Bearer token, not a model name.
# serverModelKey() in src/lib/month-plan/adapter.ts is the only reader.
# Authorization: Bearer <MONTH_PLAN_MODEL_KEY>
# Request JSON model is always the code constant MONTH_PLAN_OPENAI_MODEL (gpt-5.4-nano).
# OPENAI_API_KEY, OPENAI_MODEL, MONTHLY_MODEL, and WEEKLY_MODEL are not read.
# Used by monthly and weekly programming (authorMonth / authorWeek) and by the
# older class-week candidate picker (resolvePlannedWeek).
# Unset or blank: those calls are skipped. Programming returns no_model and
# saves generation_source=fallback. The candidate picker stays on rules.
# Local docker-compose.yml passes this name into the container.
# NAS docker-compose.nas.yml loads it from this file through env_file.
# Do not commit a real value. Do not put this in client code.
# MONTH_PLAN_MODEL_KEY=
# Optional overrides. Defaults are 90000 (week) and 60000 (month).
# MONTH_PLAN_WEEKLY_TIMEOUT_MS=
# MONTH_PLAN_MONTHLY_TIMEOUT_MS=
# Candidate-picker wait only. Does not change programming timeouts. Default 12000.
# MONTH_PLAN_MODEL_TIMEOUT_MS=

# Node environment
NODE_ENV=production
PORT=3000
