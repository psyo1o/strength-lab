# Session signing secret — generate a long random string
# openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-secret

# SQLite file path. In Docker this is /data/app.db (volume-mounted).
DATABASE_PATH=./data/app.db

# Public URL used in cookies (http is OK on a home LAN)
# APP_URL=http://192.168.1.10:3000

# Node environment
NODE_ENV=production
PORT=3000
